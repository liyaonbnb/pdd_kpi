[Unit]
Description=PDD BI Dashboard V2 Web
After=network.target pdd-v2.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/pdd_kpi
Environment=V2_WEB_DIST=/home/ubuntu/pdd_kpi/frontend/dist
Environment=V2_API_INTERNAL_URL=http://127.0.0.1:18001
ExecStart=/home/ubuntu/pdd_kpi/venv/bin/uvicorn --app-dir /home/ubuntu/pdd_kpi v2.test_web:app --host 0.0.0.0 --port 18080 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target