[Unit]
Description=PDD BI V2 isolated test web
After=network-online.target pdd-bi-v2-test.service

[Service]
Type=simple
WorkingDirectory=/opt/pdd_bi_v2_test
EnvironmentFile=/etc/pdd-bi-v2-test.env
Environment=V2_WEB_DIST=/opt/pdd_bi_v2_test/frontend/dist
ExecStart=/opt/pdd_bi_v2_test/venv/bin/uvicorn v2.test_web:app --host 0.0.0.0 --port 18080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
